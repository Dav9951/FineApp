# ─────────────────────────────────────────────────────────────
# FineApp — zmienne środowiskowe
# Skopiuj do `.env` W KORZENIU repozytorium i uzupełnij. NIE commituj pliku `.env`.
# Czytają go: docker compose (env_file) oraz API i skrypty db:* / user:create
# (szukają `.env` od bieżącego katalogu w górę do korzenia — ADR-057).
# ─────────────────────────────────────────────────────────────

# --- Runtime ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Publiczny URL aplikacji (używany do cookies / CORS / linków)
APP_URL=http://localhost:5173

# --- Baza danych ---
# W Dockerze montowany wolumen: /data/fineapp.db
DATABASE_PATH=./data/fineapp.db

# --- Pliki (paragony, wyciągi) ---
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=10485760

# --- Auth (e-mail + PIN) ---
# Sekret do podpisu JWT — wygeneruj: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# Sól do haszowania IP w logach prób logowania
IP_HASH_SALT=CHANGE_ME_random_string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PIN_MIN_LENGTH=6
PIN_MAX_LENGTH=8
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- AI / OCR (Anthropic) ---
# Wyłączone domyślnie: z AI_ENABLED=true aplikacja nie wstanie bez klucza.
# Na produkcji (i do testów OCR lokalnie) ustaw AI_ENABLED=true i ANTHROPIC_API_KEY.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_OUTPUT_TOKENS=16000
# Miesięczny limit bezpieczeństwa na koszty OCR (w groszach; 0 = brak limitu)
AI_MONTHLY_BUDGET_MINOR=5000
# Stawki do szacowania kosztu (grosze za milion tokenów wejścia / wyjścia)
AI_INPUT_COST_MINOR_PER_MTOK=800
AI_OUTPUT_COST_MINOR_PER_MTOK=4000

# --- Domena / ustawienia domyślne ---
DEFAULT_CURRENCY=PLN
DEFAULT_TIMEZONE=Europe/Warsaw
DEFAULT_LOCALE=pl-PL
